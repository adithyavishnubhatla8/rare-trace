# RARETRACE Environment Configuration Example
# ============================================

# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key

# Optional Direct PostgreSQL Connection URL (Supabase Transaction/Session Pooler):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-id.supabase.co:5432/postgres?sslmode=require

# Flask Configuration
SECRET_KEY=your_production_secret_key_dbscan_2026
FLASK_ENV=production
FLASK_DEBUG=0
PORT=5000
